@model BatchFilterVM

@{
    ViewData["Title"] = "Партии птицы";
}

<div class="container">
    <div class="row pt-3 pb-2">
        <div class="col-6">
            <h2 class="text-dark">
                Партии птицы
            </h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Batch" asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Добавить партию
            </a>
        </div>
    </div>

    <form method="get" asp-action="Index" class="mb-4">
        <div class="row">
            <div class="col-md-6 mb-2">
                <input type="text" name="batchNumberFilter" value="@Model.BatchNumberFilter"
                       class="form-control" placeholder="Поиск по номеру партии" />
            </div>
            <div class="col-md-4 mb-2">
                <select name="arrivedFilter" class="form-select">
                    <option value="">Все статусы</option>
                    <option value="true" selected="@(Model.ArrivedFilter == "true")">Прибывшие</option>
                    <option value="false" selected="@(Model.ArrivedFilter == "false")">Ожидаемые</option>
                </select>
            </div>
            <div class="col-md-2 mb-2">
                <button type="submit" class="btn btn-dark w-100">
                    <i class="bi bi-search"></i> Найти
                </button>
            </div>
        </div>
    </form>

    <table class="table table-hover table-bordered text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>Номер партии</th>
                <th>Тип птицы</th>
                <th>Порода</th>
                <th>Дата вывода</th>
                <th>Количество</th>
                <th>Источник</th>
                <th>Статус прибытия</th>
                <th>Дата прибытия</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var batch in Model.Batches)
            {
                <tr>
                    <td>@batch.BatchNumber</td>
                    <td>@batch.Type</td>
                    <td>@batch.Breed</td>
                    <td>@batch.HatchDate.ToString("d")</td>
                    <td>@batch.Count</td>
                    <td>@batch.Source</td>
                    <td>
                        @if (batch.IsArrived)
                        {
                            <span class="badge bg-success">Прибыла</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Ожидается</span>
                        }
                    </td>
                    <td>
                        @if (batch.ArrivalDate.HasValue)
                        {
                            @batch.ArrivalDate.Value.ToString("d")
                        }
                        else
                        {
                            <span class="text-muted">Не указана</span>
                        }
                    </td>
                    <td>
                        <div class="btn-group gap-2" role="group">
                            <a asp-controller="Batch" asp-action="Update" asp-route-id="@batch.Id" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Изменить
                            </a>
                            <a asp-controller="Batch" asp-action="Delete" asp-route-id="@batch.Id" class="btn btn-primary">
                                <i class="bi bi-trash"></i> Удалить
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>