@model Batch

@{
    ViewData["Title"] = "Удаление партии";
}

@using (Html.BeginForm("Delete", "Batch", FormMethod.Post, new { @class = "mt-4" }))
{
    @Html.HiddenFor(m => m.Id)
    
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-dark">Удаление партии</h2>
            <hr />
        </div>

        <div class="alert alert-dismissible alert-primary">
            <h4 class="alert-heading">Внимание!</h4>
            <p>Вы уверены, что хотите удалить эту партию? Это действие нельзя отменить.</p>
            <p class="mb-0"><strong>Внимание:</strong> При удалении партии также удалятся все связанные птицы.</p>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3 row p-1">
                    <label class="p-0">Номер партии</label>
                    @Html.TextBoxFor(m => m.BatchNumber, new { @class = "form-control", @readonly = "readonly", @disabled = "disabled" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.Breed, htmlAttributes: new { @class = "p-0" })
                    @Html.TextBoxFor(m => m.Breed, new { @class = "form-control", @readonly = "readonly", @disabled = "disabled" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.Type, htmlAttributes: new { @class = "p-0" })
                    @Html.TextBoxFor(m => m.Type, new { @class = "form-control", @readonly = "readonly", @disabled = "disabled" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.Source, htmlAttributes: new { @class = "p-0" })
                    @Html.TextBoxFor(m => m.Source, new { @class = "form-control", @readonly = "readonly", @disabled = "disabled" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.Count, htmlAttributes: new { @class = "p-0" })
                    @Html.TextBoxFor(m => m.Count, new { @class = "form-control", @readonly = "readonly", @disabled = "disabled" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.HatchDate, htmlAttributes: new { @class = "p-0" })
                    @Html.TextBoxFor(m => m.HatchDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @readonly = "readonly", @disabled = "disabled" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.ArrivalDate, htmlAttributes: new { @class = "p-0" })
                    @{
                        var arrivalDate = Model.ArrivalDate.HasValue ? Model.ArrivalDate.Value.ToString("yyyy-MM-dd") : "";
                    }
                    @Html.TextBox("ArrivalDateDisplay", arrivalDate, new { @class = "form-control", @readonly = "readonly", @disabled = "disabled" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3 row p-1">
                    <div class="form-check mt-4">
                        @Html.CheckBoxFor(m => m.IsArrived, new {
                            @class = "form-check-input",
                            style = "width: 20px; height: 20px; margin-right: 10px;",
                            @disabled = "disabled"
                        })
                        @Html.LabelFor(m => m.IsArrived, "Партия прибыла", new {
                            @class = "form-check-label fs-6 fw-medium"
                        })
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-3">
                <a href="@Url.Action("Index", "Batch")" class="btn btn-secondary form-control">
                    <i class="bi bi-arrow-left"></i> Назад к списку
                </a>
            </div>
            <div class="col-3">
                <button type="submit" class="btn btn-primary form-control">
                    <i class="bi bi-trash"></i> Удалить
                </button>
            </div>
        </div>
    </div>
}