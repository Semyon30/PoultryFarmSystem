@model HealthCardFilterVM

@{
    ViewData["Title"] = "Медицинские карты";
}

<div class="container">
    <div class="row pt-3 pb-2">
        <div class="col-6">
            <h2 class="text-dark">
                Медицинские карты
            </h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="HealthCard" asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Добавить медкарту
            </a>
        </div>
    </div>

    <form method="get" asp-action="Index" class="mb-4">
        <div class="row">
            <div class="col-md-5 mb-2">
                <input type="text" name="birdNumberFilter" value="@Model.BirdNumberFilter"
                       class="form-control" placeholder="Поиск по номеру птицы" />
            </div>
            <div class="col-md-5 mb-2">
                <input type="text" name="vaccinationsFilter" value="@Model.VaccinationsFilter"
                       class="form-control" placeholder="Поиск по вакцинам" />
            </div>
            <div class="col-md-2 mb-2">
                <button type="submit" class="btn btn-dark w-100">
                    <i class="bi bi-search"></i> Найти
                </button>
            </div>
        </div>
    </form>

    <table class="table table-hover table-bordered text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>Номер птицы</th>
                <th>Тип птицы</th>
                <th>Вакцины</th>
                <th>Заболевания</th>
                <th>Аллергии</th>
                <th>Особые заметки</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var card in Model.HealthCards)
            {
                <tr>
                    <td>@card.Bird.BirdNumber</td>
                    <td>@card.Bird.Type</td>
                    <td>@card.Vaccinations</td>
                    <td>
                        @if (string.IsNullOrEmpty(card.Diseases) || card.Diseases == "Нет")
                        {
                            <span class="text-success">Нет</span>
                        }
                        else
                        {
                            <span class="text-primary">@card.Diseases</span>
                        }
                    </td>
                    <td>
                        @if (string.IsNullOrEmpty(card.Allergies) || card.Allergies == "Нет")
                        {
                            <span class="text-success">Нет</span>
                        }
                        else
                        {
                            <span class="text-warning">@card.Allergies</span>
                        }
                    </td>
                    <td>@card.SpecialNotes</td>
                    <td>
                        <div class="btn-group gap-2" role="group">
                            <a asp-controller="HealthCard" asp-action="Update" asp-route-id="@card.Id" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Изменить
                            </a>
                            <a asp-controller="HealthCard" asp-action="Delete" asp-route-id="@card.Id" class="btn btn-primary">
                                <i class="bi bi-trash"></i> Удалить
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>