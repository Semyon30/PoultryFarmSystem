@model Bird

@{
    ViewData["Title"] = "Редактирование птицы";
}

@using (Html.BeginForm("Update", "Bird", FormMethod.Post, new { @class = "mt-4" }))
{
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.BirdNumber)
    
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-dark">Редактирование птицы</h2>
            <hr />
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3 row p-1">
                    <label class="p-0">Номер птицы</label>
                    <input type="text" class="form-control" readonly value="@Model.BirdNumber" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.Weight, htmlAttributes: new { @class = "p-0" })
                    @Html.TextBoxFor(m => m.Weight, new { @class = "form-control", type = "number", step = "0.01", min = "0.01", placeholder = "Вес в кг" })
                    @Html.ValidationMessageFor(m => m.Weight, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.Type, htmlAttributes: new { @class = "p-0" })
                    @Html.DropDownListFor(m => m.Type, 
                        ViewBag.BirdTypes as IEnumerable<SelectListItem>,
                        "Выберите тип птицы",
                        new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Type, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.Status, htmlAttributes: new { @class = "p-0" })
                    @Html.DropDownListFor(m => m.Status, 
                        ViewBag.BirdStatuses as IEnumerable<SelectListItem>,
                        "Выберите статус",
                        new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Status, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.LastHealthCheck, htmlAttributes: new { @class = "p-0" })
                    @Html.TextBoxFor(m => m.LastHealthCheck, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.LastHealthCheck, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.BatchId, "Партия", new { @class = "p-0" })
                    @Html.DropDownListFor(m => m.BatchId, 
                        ViewBag.Batches as IEnumerable<SelectListItem>,
                        "Выберите партию",
                        new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.BatchId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.CageId, "Клетка", new { @class = "p-0" })
                    @Html.DropDownListFor(m => m.CageId, 
                        ViewBag.Cages as IEnumerable<SelectListItem>,
                        "Выберите клетку",
                        new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.CageId, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-3">
                <a href="@Url.Action("Index", "Bird")" class="btn btn-secondary form-control">
                    <i class="bi bi-arrow-left"></i> Назад к списку
                </a>
            </div>
            <div class="col-3">
                <button type="submit" class="btn btn-warning form-control">
                    <i class="bi bi-pencil"></i> Обновить
                </button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}