@model AssignmentFilterVM

@{
    ViewData["Title"] = "Задания";
}

<div class="container">
    <div class="row pt-3 pb-2">
        <div class="col-6">
            <h2 class="text-dark">
                Задания
            </h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Assignment" asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Добавить задание
            </a>
        </div>
    </div>

    <form method="get" asp-action="Index" class="mb-4">
        <div class="row">
            <div class="col-md-4 mb-2">
                <input type="text" name="workerFilter" value="@Model.WorkerFilter"
                       class="form-control" placeholder="Поиск по ФИО работника" />
            </div>
            <div class="col-md-3 mb-2">
                <select name="statusFilter" class="form-select">
                    <option value="">Все статусы</option>
                    <option value="Назначено" selected="@(Model.StatusFilter == "Назначено")">Назначено</option>
                    <option value="Выполняется" selected="@(Model.StatusFilter == "Выполняется")">Выполняется</option>
                    <option value="Проверяется" selected="@(Model.StatusFilter == "Проверяется")">Проверяется</option>
                    <option value="Завершено" selected="@(Model.StatusFilter == "Завершено")">Завершено</option>
                    <option value="Отменено" selected="@(Model.StatusFilter == "Отменено")">Отменено</option>
                </select>
            </div>
            <div class="col-md-3 mb-2">
                <select name="priorityFilter" class="form-select">
                    <option value="">Все приоритеты</option>
                    <option value="Низкий" selected="@(Model.PriorityFilter == "Низкий")">Низкий</option>
                    <option value="Средний" selected="@(Model.PriorityFilter == "Средний")">Средний</option>
                    <option value="Высокий" selected="@(Model.PriorityFilter == "Высокий")">Высокий</option>
                    <option value="Критический" selected="@(Model.PriorityFilter == "Критический")">Критический</option>
                </select>
            </div>
            <div class="col-md-2 mb-2">
                <button type="submit" class="btn btn-dark w-100">
                    <i class="bi bi-search"></i> Найти
                </button>
            </div>
        </div>
    </form>

    <table class="table table-hover table-bordered text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>Название задания</th>
                <th>Описание</th>
                <th>Статус</th>
                <th>Приоритет</th>
                <th>Работник</th>
                <th>Клетка</th>
                <th>Дата начала</th>
                <th>Дата окончания</th>
                <th>Дата завершения</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var assignment in Model.Assignments)
            {
                <tr>
                    <td>@assignment.Title</td>
                    <td>@assignment.Description</td>
                    <td>
                        @switch (assignment.Status)
                        {
                            case AssignmentStatus.Назначено:
                                <span class="badge bg-danger">Назначено</span>
                                break;
                            case AssignmentStatus.Выполняется:
                                <span class="badge bg-secondary">Выполняется</span>
                                break;
                            case AssignmentStatus.Проверяется:
                                <span class="badge bg-info">Проверяется</span>
                                break;
                            case AssignmentStatus.Завершено:
                                <span class="badge bg-success">Завершено</span>
                                break;
                            case AssignmentStatus.Отменено:
                                <span class="badge bg-primary">Отменено</span>
                                break;
                        }
                    </td>
                    <td>
                        @switch (assignment.Priority)
                        {
                            case PriorityLevel.Низкий:
                                <span class="badge bg-success">Низкий</span>
                                break;
                            case PriorityLevel.Средний:
                                <span class="badge bg-warning text-dark">Средний</span>
                                break;
                            case PriorityLevel.Высокий:
                                <span class="badge bg-warning">Высокий</span>
                                break;
                            case PriorityLevel.Критический:
                                <span class="badge bg-primary">Критический</span>
                                break;
                        }
                    </td>
                    <td>@assignment.Worker.LastName @assignment.Worker.FirstName @assignment.Worker.MiddleName</td>
                    <td>@assignment.Cage.Number</td>
                    <td>@assignment.StartDate.ToString("d")</td>
                    <td>@assignment.EndDate.ToString("d")</td>
                    <td>
                        @if (assignment.CompletedDate.HasValue)
                        {
                            @assignment.CompletedDate.Value.ToString("d")
                        }
                        else
                        {
                            <span class="text-muted">Не завершено</span>
                        }
                    </td>
                    <td>
                        <div class="btn-group gap-2" role="group">
                            <a asp-controller="Assignment" asp-action="Update" asp-route-id="@assignment.Id" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Изменить
                            </a>
                            <a asp-controller="Assignment" asp-action="Delete" asp-route-id="@assignment.Id" class="btn btn-primary">
                                <i class="bi bi-trash"></i> Удалить
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>