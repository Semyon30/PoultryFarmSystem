@model Worker

@{
    ViewData["Title"] = "Добавление нового работника";
}

@using (Html.BeginForm("Create", "Worker", FormMethod.Post, new { @class = "mt-4" }))
{
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-dark">Добавление нового работника</h2>
            <hr />
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.LastName, htmlAttributes: new { @class = "p-0" })
                    @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.FirstName, htmlAttributes: new { @class = "p-0" })
                    @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.MiddleName, htmlAttributes: new { @class = "p-0" })
                    @Html.TextBoxFor(m => m.MiddleName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.MiddleName, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.Phone, htmlAttributes: new { @class = "p-0" })
                    @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "79991234567", type = "tel" })
                    @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.BirthDate, htmlAttributes: new { @class = "p-0" })
                    @Html.TextBoxFor(m => m.BirthDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.BirthDate, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.Type, htmlAttributes: new { @class = "p-0" })
                    @Html.DropDownListFor(m => m.Type, 
                        ViewBag.WorkerTypes as IEnumerable<SelectListItem>,
                        "Выберите должность",
                        new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Type, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.HireDate, htmlAttributes: new { @class = "p-0" })
                    @Html.TextBoxFor(m => m.HireDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.HireDate, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3 row p-1">
                    @Html.LabelFor(m => m.Salary, htmlAttributes: new { @class = "p-0" })
                    @Html.TextBoxFor(m => m.Salary, new { @class = "form-control", type = "number", step = "0.01" })
                    @Html.ValidationMessageFor(m => m.Salary, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="mb-3 row p-1">
            <div class="form-check">
                @Html.CheckBoxFor(m => m.IsActive, new {
                    @class = "form-check-input",
                    style = "width: 20px; height: 20px; margin-right: 10px;"
                })
                @Html.LabelFor(m => m.IsActive, htmlAttributes: new {
                    @class = "form-check-label fs-5 fw-medium"
                })
            </div>
            @Html.ValidationMessageFor(m => m.IsActive, "", new { @class = "text-danger" })
        </div>

        <div class="row">
            <div class="col-3">
                <a href="@Url.Action("Index", "Worker")" class="btn btn-secondary form-control">
                    <i class="bi bi-arrow-left"></i> Назад к списку
                </a>
            </div>
            <div class="col-3">
                <button type="submit" class="btn btn-success form-control">
                    <i class="bi bi-plus-square"></i> Создать
                </button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}