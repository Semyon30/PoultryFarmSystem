@{
    ViewData["Title"] = "Главная страница";
    Layout = "_Layout_Empty";

}

<div class="container-fluid p-0">
    <div class="hero-section text-dark text-center py-5 mb-5">
        <div class="container">
            <h1 class="display-1 fw-bold mb-3">Птицеферма Семеновское</h1>
            <p class="lead fs-3 text-secondary">Крупнейший производитель качественной птицеводческой продукции</p>
        </div>
    </div>

    <div class="container mb-5">
        <div class="row text-center">
            <div class="col-md-3 mb-4">
                <div class="card h-100 border-2 border-warning shadow-lg">
                    <div class="card-body">
                        <i class="bi bi-egg-fried display-1 text-warning mb-3"></i>
                        <h3 class="card-title">50,000+</h3>
                        <p class="card-text">Яиц ежедневно</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card h-100 border-2 border-success shadow-lg">
                    <div class="card-body">
                        <i class="bi bi-house display-1 text-success mb-3"></i>
                        <h3 class="card-title">100+</h3>
                        <p class="card-text">Клеток для птиц</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card h-100 border-2 border-info shadow-lg">
                    <div class="card-body">
                        <i class="bi bi-people display-1 text-info mb-3"></i>
                        <h3 class="card-title">50+</h3>
                        <p class="card-text">Сотрудников</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card h-100 border-2 border-danger shadow-lg">
                    <div class="card-body">
                        <i class="bi bi-award display-1 text-danger mb-3"></i>
                        <h3 class="card-title">15+</h3>
                        <p class="card-text">Лет на рынке</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-light py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="display-4 fw-bold text-dark mb-3">НАШИ ПАРТНЁРЫ</h2>
                <p class="lead text-muted">Сотрудничаем с ведущими компаниями отрасли</p>
            </div>

            <div class="row align-items-stretch justify-content-center">
                <div class="col-md-3 col-6 mb-4 d-flex">
                    <div class="partner-card p-4 bg-white rounded-3 border border-1 shadow d-flex flex-column w-100">
                        <div class="flex-grow-1 d-flex flex-column justify-content-center">
                            <img src="images/logos/kfc.png"
                                 alt="KFC" class="img-fluid mx-auto" style="max-height: 80px; object-fit: contain;">
                        </div>
                        <div class="text-center">
                            <h5 class="mt-3 mb-1">KFC</h5>
                            <p class="text-muted mb-0">Международная сеть ресторанов</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6 mb-4 d-flex">
                    <div class="partner-card p-4 bg-white rounded-3 border border-1 shadow d-flex flex-column w-100">
                        <div class="flex-grow-1 d-flex flex-column justify-content-center">
                            <img src="/images/logos/mac.png"
                                 alt="McDonald's" class="img-fluid mx-auto" style="max-height: 80px; object-fit: contain;">
                        </div>
                        <div class="text-center"> 
                            <h5 class="mt-3 mb-1">McDonald's</h5>
                            <p class="text-muted mb-0">Крупнейшая сеть фастфуда</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6 mb-4 d-flex">
                    <div class="partner-card p-4 bg-white rounded-3 border border-1 shadow d-flex flex-column w-100">
                        <div class="flex-grow-1 d-flex flex-column justify-content-center">
                            <img src="/images/logos/magnit.png"
                                 alt="Магнит" class="img-fluid mx-auto" style="max-height: 80px; object-fit: contain;">
                        </div>
                        <div class="text-center">
                            <h5 class="mt-3 mb-1">Магнит</h5>
                            <p class="text-muted mb-0">Крупная розничная сеть</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6 mb-4 d-flex">
                    <div class="partner-card p-4 bg-white rounded-3 border border-1 shadow d-flex flex-column w-100">
                        <div class="flex-grow-1 d-flex flex-column justify-content-center">
                            <img src="/images/logos/pyatorochka.png"
                                 alt="Пятёрочка" class="img-fluid mx-auto" style="max-height: 80px; object-fit: contain;">
                        </div>
                        <div class="text-center"> 
                            <h5 class="mt-3 mb-1">Пятёрочка</h5>
                            <p class="text-muted mb-0">Сеть продуктовых магазинов</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row align-items-stretch justify-content-center mt-4">
                <div class="col-md-3 col-6 mb-4 d-flex">
                    <div class="partner-card p-4 bg-white rounded-3 border border-1 shadow d-flex flex-column w-100">
                        <div class="flex-grow-1 d-flex flex-column justify-content-center">
                            <img src="/images/logos/perekrestok.png"
                                 alt="Перекрёсток" class="img-fluid mx-auto" style="max-height: 80px; object-fit: contain;">
                        </div>
                        <div class="text-center"> 
                            <h5 class="mt-3 mb-1">Перекрёсток</h5>
                            <p class="text-muted mb-0">Сеть супермаркетов</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6 mb-4 d-flex">
                    <div class="partner-card p-4 bg-white rounded-3 border border-1 shadow d-flex flex-column w-100">
                        <div class="flex-grow-1 d-flex flex-column justify-content-center">
                            <img src="/images/logos/bk.png"
                                 alt="Burger King" class="img-fluid mx-auto" style="max-height: 80px; object-fit: contain;">
                        </div>
                        <div class="text-center"> 
                            <h5 class="mt-3 mb-1">Burger King</h5>
                            <p class="text-muted mb-0">Международная сеть ресторанов</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6 mb-4 d-flex">
                    <div class="partner-card p-4 bg-white rounded-3 border border-1 shadow d-flex flex-column w-100">
                        <div class="flex-grow-1 d-flex flex-column justify-content-center">
                            <img src="/images/logos/metro.png"
                                 alt="METRO" class="img-fluid mx-auto" style="max-height: 80px; object-fit: contain;">
                        </div>
                        <div class="text-center"> 
                            <h5 class="mt-3 mb-1">METRO</h5>
                            <p class="text-muted mb-0">Оптовый ритейлер</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container py-5">
        <div class="text-center mb-5">
            <h2 class="display-4 fw-bold text-dark mb-3">ПОЧЕМУ ВЫБИРАЮТ НАС</h2>
        </div>

        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="text-center p-4 border border-2 border-info rounded-3 shadow-sm">
                    <i class="bi bi-shield-check text-info display-1 mb-3"></i>
                    <h4>Качество продукции</h4>
                    <p class="text-muted">Строгий контроль производства</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="text-center p-4 border border-2 border-success rounded-3 shadow-sm">
                    <i class="bi bi-tree display-1 text-success mb-3"></i>
                    <h4>Экологичность</h4>
                    <p class="text-muted">Экологически чистое производство</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="text-center p-4 border border-2 border-warning rounded-3 shadow-sm">
                    <i class="bi bi-truck text-warning display-1 mb-3"></i>
                    <h4>Быстрая доставка</h4>
                    <p class="text-muted">Доставка в течение 24 часов</p>
                </div>
            </div>
        </div>
    </div>
</div>
